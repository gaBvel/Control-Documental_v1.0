<%- include('../partials/head', { title, styles }) %>
<div class="contenedor"><%- include('../partials/sidebar', { menu, usuario }) %><main class="contenido usuario-panel"><header class="usuario-encabezado"><div><p class="eyebrow">CONTROL INSTITUCIONAL</p><h1>Inventarios documentales</h1><span>Consulta y da seguimiento a los inventarios registrados por las áreas.</span></div></header><section class="usuario-tabla tabla"><div class="usuario-seccion-titulo"><div><p class="eyebrow">BANDEJA DE CONSULTA</p><h2>Inventarios registrados</h2></div><span class="contador-registros"><%= inventarios.length %> registros</span></div><div class="tabla-responsive"><table><thead><tr><th>Responsable</th><th>Subfondo</th><th>Unidad administrativa</th><th>Área generadora</th><th>Fecha</th><th>Estatus</th></tr></thead><tbody><% if (inventarios.length) { inventarios.forEach(inventario => { %><tr><td><%= inventario.nombre %></td><td><%= inventario.subfondo %></td><td><%= inventario.unidad_administrativa %></td><td><%= inventario.area_generadora %></td><td><%= new Date(inventario.fecha_envio).toLocaleDateString('es-MX') %></td><td><span class="<%= inventario.estatus %>"><%= inventario.estatus %></span></td></tr><% }) } else { %><tr class="fila-vacia"><td colspan="6"><div class="estado-vacio estado-vacio-tabla"><span><i class="fa-solid fa-box-archive"></i></span><h3>No hay inventarios registrados</h3><p>Cuando las áreas registren sus inventarios, podrás consultarlos desde este panel.</p></div></td></tr><% } %></tbody></table></div></section></main></div><%- include('../partials/profile-modal', { usuario }) %><%- include('../partials/scripts', { sidebar: true, scripts: [] }) %>
