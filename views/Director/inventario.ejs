<!-- Head -->
<%- include('../partials/head', { title, styles }) %>

<div class="contenedor">
    <!-- Sidebar -->
    <%- include('../partials/sidebar', { menu, usuario }) %>
    
    <main class="contenido">
        <header>
            <h1>Control de inventarios</h1>
            <p>Consulta y gestión de expedientes físicos y digitales.</p>
        </header>
        
        <section class="tabla filtros">
            <input type="search" placeholder="Buscar expediente...">
            <select>
                <option>Tipo</option>
                <option>Inventario</option>
                <option>Expediente</option>
            </select>
            <select>
                <option>Estado</option>
                <option>Activo</option>
                <option>Revisión</option>
            </select>
            <button type="button">Buscar</button>
        </section>
        <section class="tabla">
            <table>
                <thead>
                    <tr>
                        <th>Folio</th>
                        <th>Expediente</th>
                        <th>Área</th>
                        <th>Responsable</th>
                        <th>Estado</th>
                        <th>Acción</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td colspan="6">No hay inventarios registrados.</td>
                    </tr>
                </tbody>
            </table>
        </section>
    </main>
</div>

<!-- Modal perfil -->
<%- include('../partials/profile-modal', { usuario }) %>

<!-- Scripts -->
<%- include('../partials/scripts', { sidebar: true, scripts: [] }) %>
