<%- include('../partials/head', { title, styles }) %>
<div class="contenedor"><%- include('../partials/sidebar', { menu, usuario }) %><main class="contenido usuario-panel"><header class="usuario-encabezado"><div><p class="eyebrow">CONSULTA HISTÓRICA</p><h1>Historial institucional</h1><span>Revisa el registro de inventarios y sus movimientos de validación.</span></div></header><section class="usuario-tabla tabla"><div class="usuario-seccion-titulo"><div><p class="eyebrow">MOVIMIENTOS</p><h2>Historial de inventarios</h2></div><span class="contador-registros"><%= inventarios.length %> registros</span></div><div class="tabla-responsive"><table><thead><tr><th>Responsable</th><th>Envío</th><th>Resolución</th><th>Estatus</th></tr></thead><tbody><% if (inventarios.length) { inventarios.forEach(inventario => { %><tr><td><%= inventario.nombre %></td><td><%= new Date(inventario.fecha_envio).toLocaleString('es-MX') %></td><td><%= inventario.fecha_revision ? new Date(inventario.fecha_revision).toLocaleString('es-MX') : 'Pendiente' %></td><td><span class="<%= inventario.estatus %>"><%= inventario.estatus %></span></td></tr><% }) } else { %><tr class="fila-vacia"><td colspan="4"><div class="estado-vacio estado-vacio-tabla"><span><i class="fa-solid fa-clock-rotate-left"></i></span><h3>No hay movimientos para mostrar</h3><p>El historial estará disponible cuando existan inventarios enviados y revisados.</p></div></td></tr><% } %></tbody></table></div></section></main></div><%- include('../partials/profile-modal', { usuario }) %><%- include('../partials/scripts', { sidebar: true, scripts: [] }) %>
