<%- include('../partials/head', { title, styles }) %>
<div class="contenedor"><%- include('../partials/sidebar', { menu, usuario }) %><main class="contenido usuario-panel"><header class="usuario-encabezado"><div><p class="eyebrow">VISIÓN EJECUTIVA</p><h1>Panel del Director</h1><span>Consulta el panorama general de la gestión documental institucional.</span></div><a class="boton-principal" href="/director/inventario"><i class="fa-solid fa-box-archive"></i> Ver inventarios</a></header>
<section class="usuario-resumen"><article class="usuario-metrica"><span class="metrica-icono borrador"><i class="fa-solid fa-folder"></i></span><div><small>Inventarios</small><strong><%= resumen.total %></strong><p>Registros institucionales</p></div></article><article class="usuario-metrica"><span class="metrica-icono aprobado"><i class="fa-solid fa-circle-check"></i></span><div><small>Aprobados</small><strong><%= resumen.aprobado %></strong><p>Validados por Archivo</p></div></article><article class="usuario-metrica"><span class="metrica-icono enviado"><i class="fa-solid fa-clock"></i></span><div><small>Pendientes</small><strong><%= resumen.pendiente %></strong><p>En proceso de revisión</p></div></article><article class="usuario-metrica"><span class="metrica-icono rechazado"><i class="fa-solid fa-circle-xmark"></i></span><div><small>Rechazados</small><strong><%= resumen.rechazado %></strong><p>Requieren seguimiento</p></div></article></section>
<section class="usuario-grid"><article class="usuario-tabla tabla"><div class="usuario-seccion-titulo"><div><p class="eyebrow">SEGUIMIENTO INSTITUCIONAL</p><h2>Últimos inventarios</h2><span>Movimientos documentales más recientes.</span></div><a href="/director/historial">Ver historial <i class="fa-solid fa-arrow-right"></i></a></div><div class="tabla-responsive"><table><thead><tr><th>Responsable</th><th>Área</th><th>Estatus</th></tr></thead><tbody><% if (recientes.length) { recientes.forEach(inventario => { %><tr><td><%= inventario.nombre %></td><td><%= inventario.area_generadora %></td><td><span class="<%= inventario.estatus %>"><%= inventario.estatus %></span></td></tr><% }) } else { %><tr class="fila-vacia"><td colspan="3"><div class="estado-vacio"><span><i class="fa-regular fa-folder-open"></i></span><h3>Aún no hay inventarios registrados</h3><p>Los inventarios enviados aparecerán en este espacio.</p></div></td></tr><% } %></tbody></table></div></article><aside class="usuario-ayuda"><span class="ayuda-icono"><i class="fa-solid fa-chart-line"></i></span><p class="eyebrow">CONTROL DOCUMENTAL</p><h2>Seguimiento centralizado</h2><p>Consulta los registros y su estado para facilitar la toma de decisiones.</p><a href="/director/inventario">Ir al control <i class="fa-solid fa-arrow-right"></i></a></aside></section>
</main></div><%- include('../partials/profile-modal', { usuario }) %><%- include('../partials/scripts', { sidebar: true, scripts: [] }) %>
