<!-- Head -->
<%- include('../partials/head', { title, styles }) %>
    <div class="container">
        <!--Izquierda-->
        <div class="left-panel">
            <div class="overlay">
                <div class="logo-container">
                    <img src="/resources/img/star.ico">
                    <h1>SCD</h1>
                    <h2>Sistema de Control Documental</h2>
                </div>
            </div>
        </div>
        
        <!--Derecha-->
        <div class="right-panel">
            <div class="login-card">
                <h2>Iniciar Sesión</h2>
                <p class="subtitle">
                    Ingresa tus credenciales para continuar
                </p>

                <form action="/login" method="POST" id="loginForm" novalidate>
                    <div class="input-group">
                        <label>Correo electrónico</label>
                        <div class="input-box">
                            <i class="fa-solid fa-envelope"></i>
                            <input id="correo"
                                type="email" 
                                name="correo" 
                                placeholder="usuario@correo.com"
                                required
                            >
                        </div>
                    </div>

                    <div class="input-group">
                        <label>Contraseña</label>
                        <div class="input-box">
                            <i class="fa-solid fa-lock"></i>
                            <input id="password"
                                type="password" 
                                name="password" 
                                placeholder="Ingrese su contraseña"
                                required
                            >
                        </div>
                    </div>
                    <div id="loginMessage" class="login-message" role="alert" aria-live="polite"></div>
                    <button class="btn-login" type="submit">Ingresar</button>
                </form>
            </div>
        </div>
    </div>
    
<%- include('../partials/scripts', { sidebar: false, scripts: ['login.js'] }) %>
