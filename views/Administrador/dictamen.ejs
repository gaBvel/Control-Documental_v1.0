<%- include('../partials/head', { title, styles }) %>
<div class="contenedor"><%- include('../partials/sidebar', { menu, usuario }) %><main class="contenido usuario-panel">
  <header class="usuario-encabezado"><div><p class="eyebrow">ADMINISTRACIÓN</p><h1>Dictámenes registrados</h1><span>Consulta los dictámenes y sus documentos asociados.</span></div><button class="boton-principal" type="button" data-modal-open="modalDictamen"><i class="fa-solid fa-plus"></i> Registrar dictamen</button></header>
  <section class="usuario-tabla tabla admin-tabla"><div class="usuario-seccion-titulo"><div><p class="eyebrow">DICTÁMENES</p><h2>Registro general</h2></div><span class="contador-registros"><%= dictamenes.length %> registros</span></div><div class="tabla-responsive"><table><thead><tr><th>Fecha</th><th>Tipo</th><th>Dictamen</th><th>Acta</th><th>Evidencia</th><th>Observación</th></tr></thead><tbody><% if (dictamenes.length) { dictamenes.forEach(item => { %><tr><td><%= new Date(item.fecha_dictamen).toLocaleDateString('es-MX') %></td><td><span class="pendiente"><%= item.tipo_dictamen %></span></td><td><button class="boton-ver-archivo" type="button" data-file-view="<%= item.archivo_dictamen %>" title="Ver dictamen" aria-label="Ver dictamen"><i class="fa-solid fa-eye"></i></button></td><td><% if (item.archivo_acta) { %><button class="boton-ver-archivo" type="button" data-file-view="<%= item.archivo_acta %>" title="Ver acta" aria-label="Ver acta"><i class="fa-solid fa-eye"></i></button><% } else { %>Sin archivo<% } %></td><td><% if (item.evidencia) { %><button class="boton-ver-archivo" type="button" data-file-view="<%= item.evidencia %>" title="Ver evidencia" aria-label="Ver evidencia"><i class="fa-solid fa-eye"></i></button><% } else { %>Sin evidencia<% } %></td><td><%= item.observacion || 'Sin observaciones' %></td></tr><% }) } else { %><tr class="fila-vacia"><td colspan="6"><div class="estado-vacio estado-vacio-tabla"><span><i class="fa-solid fa-file-signature"></i></span><h3>No hay dictámenes registrados</h3><p>Los dictámenes del sistema aparecerán aquí.</p></div></td></tr><% } %></tbody></table></div></section>
</main></div>
<div class="modal modal-formulario" id="modalDictamen" aria-hidden="true" role="dialog" aria-labelledby="tituloModalDictamen" aria-modal="true"><form class="modal-contenido" action="<%= formAction %>" method="post" enctype="multipart/form-data"><div class="modal-encabezado"><div><p class="eyebrow">NUEVO REGISTRO</p><h2 id="tituloModalDictamen">Registrar dictamen</h2></div><button class="modal-cerrar" type="button" aria-label="Cerrar" data-modal-close="modalDictamen"><i class="fa-solid fa-xmark"></i></button></div><p class="modal-descripcion">Captura la información principal del dictamen para agregarlo al historial.</p><div class="campo"><label for="fechaDictamen">Fecha del dictamen</label><input id="fechaDictamen" name="fechaDictamen" type="date" required></div><div class="campo"><label for="archivoDictamen">Archivo del dictamen</label><input id="archivoDictamen" name="archivoDictamen" type="file" accept=".pdf,.doc,.docx" required></div><div class="campo"><label for="tipoDictamen">Tipo de dictamen</label><select id="tipoDictamen" name="tipoDictamen" required><option value="">Selecciona una opción</option><option value="Aprobación">Aprobación</option><option value="Rechazo">Rechazo</option><option value="Observación">Con observaciones</option></select></div><div class="campo"><label for="archivoActa">Archivo del acta <small>(opcional)</small></label><input id="archivoActa" name="archivoActa" type="file" accept=".pdf,.doc,.docx"></div><div class="campo"><label for="evidencia">Evidencia <small>(opcional)</small></label><input id="evidencia" name="evidencia" type="file" accept=".pdf,.doc,.docx,.png,.jpg,.jpeg"></div><div class="campo"><label for="observacion">Notas u observaciones</label><input id="observacion" name="observacion" type="text" maxlength="1000"></div><div class="modal-acciones"><button class="boton-secundario" type="button" data-modal-close="modalDictamen">Cancelar</button><button class="boton-principal" type="submit"><i class="fa-solid fa-floppy-disk"></i> Registrar</button></div></form></div>
<%- include('../partials/profile-modal', { usuario }) %><%- include('../partials/scripts', { sidebar: true, scripts: ['dictamen.js'] }) %>
