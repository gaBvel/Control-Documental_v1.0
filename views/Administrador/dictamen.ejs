<%- include('../partials/head', { title, styles }) %>
<div class="contenedor"><%- include('../partials/sidebar', { menu, usuario }) %><main class="contenido usuario-panel">
  <header class="usuario-encabezado"><div><p class="eyebrow">ADMINISTRACIÓN</p><h1>Dictámenes registrados</h1><span>Consulta los dictámenes y sus documentos asociados.</span></div></header>
  <section class="usuario-tabla tabla admin-tabla"><div class="usuario-seccion-titulo"><div><p class="eyebrow">DICTÁMENES</p><h2>Registro general</h2></div><span class="contador-registros"><%= dictamenes.length %> registros</span></div><div class="tabla-responsive"><table><thead><tr><th>Fecha</th><th>Tipo</th><th>Dictamen</th><th>Acta</th><th>Evidencia</th><th>Observación</th></tr></thead><tbody><% if (dictamenes.length) { dictamenes.forEach(item => { %><tr><td><%= new Date(item.fecha_dictamen).toLocaleDateString('es-MX') %></td><td><span class="pendiente"><%= item.tipo_dictamen %></span></td><td><a href="<%= item.archivo_dictamen %>" target="_blank">Ver archivo</a></td><td><%= item.archivo_acta ? 'Adjunta' : 'Sin archivo' %></td><td><%= item.evidencia ? 'Adjunta' : 'Sin evidencia' %></td><td><%= item.observacion || 'Sin observaciones' %></td></tr><% }) } else { %><tr class="fila-vacia"><td colspan="6"><div class="estado-vacio estado-vacio-tabla"><span><i class="fa-solid fa-file-signature"></i></span><h3>No hay dictámenes registrados</h3><p>Los dictámenes del sistema aparecerán aquí.</p></div></td></tr><% } %></tbody></table></div></section>
</main></div><%- include('../partials/profile-modal', { usuario }) %><%- include('../partials/scripts', { sidebar: true, scripts: [] }) %>
