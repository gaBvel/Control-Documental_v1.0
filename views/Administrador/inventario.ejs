<%- include('../partials/head', { title, styles }) %>
<div class="contenedor"><%- include('../partials/sidebar', { menu, usuario }) %><main class="contenido usuario-panel">
  <header class="usuario-encabezado"><div><p class="eyebrow">ADMINISTRACIÓN</p><h1>Inventarios registrados</h1><span>Consulta todos los envíos documentales del sistema.</span></div></header>
  <section class="usuario-tabla tabla admin-tabla"><div class="usuario-seccion-titulo"><div><p class="eyebrow">INVENTARIOS</p><h2>Registro general</h2></div><span class="contador-registros"><%= inventarios.length %> registros</span></div><div class="tabla-responsive"><table><thead><tr><th>Usuario</th><th>Subfondo</th><th>Unidad administrativa</th><th>Área generadora</th><th>Envío</th><th>Estatus</th></tr></thead><tbody><% if (inventarios.length) { inventarios.forEach(item => { %><tr><td><%= item.nombre %></td><td><%= item.subfondo %></td><td><%= item.unidad_administrativa %></td><td><%= item.area_generadora %></td><td><%= new Date(item.fecha_envio).toLocaleString('es-MX') %></td><td><span class="<%= item.estatus %>"><%= item.estatus %></span></td></tr><% }) } else { %><tr class="fila-vacia"><td colspan="6"><div class="estado-vacio estado-vacio-tabla"><span><i class="fa-solid fa-box-archive"></i></span><h3>No hay inventarios registrados</h3><p>Los envíos documentales aparecerán aquí.</p></div></td></tr><% } %></tbody></table></div></section>
</main></div><%- include('../partials/profile-modal', { usuario }) %><%- include('../partials/scripts', { sidebar: true, scripts: [] }) %>
