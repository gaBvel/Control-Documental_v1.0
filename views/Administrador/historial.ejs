<%- include('../partials/head', { title, styles }) %>
<div class="contenedor"><%- include('../partials/sidebar', { menu, usuario }) %><main class="contenido usuario-panel">
  <header class="usuario-encabezado"><div><p class="eyebrow">ADMINISTRACIÓN</p><h1>Historial del sistema</h1><span>Revisa los movimientos recientes registrados en los módulos.</span></div></header>
  <section class="usuario-tabla tabla admin-tabla"><div class="usuario-seccion-titulo"><div><p class="eyebrow">MOVIMIENTOS</p><h2>Actividad completa</h2></div><span class="contador-registros"><%= actividad.length %> movimientos</span></div><div class="tabla-responsive"><table><thead><tr><th>Usuario</th><th>Acción</th><th>Módulo</th><th>Fecha y hora</th><th>Estado</th></tr></thead><tbody><% if (actividad.length) { actividad.forEach(item => { %><tr><td><%= item.usuario %></td><td><%= item.accion %></td><td><%= item.modulo %></td><td><%= new Date(item.fecha).toLocaleString('es-MX') %></td><td><span class="<%= item.estatus %> estado-actividad"><%= item.estatus %></span></td></tr><% }) } else { %><tr class="fila-vacia"><td colspan="5"><div class="estado-vacio estado-vacio-tabla"><span><i class="fa-solid fa-clock-rotate-left"></i></span><h3>No hay actividad registrada</h3><p>Los movimientos del sistema aparecerán aquí.</p></div></td></tr><% } %></tbody></table></div></section>
</main></div><%- include('../partials/profile-modal', { usuario }) %><%- include('../partials/scripts', { sidebar: true, scripts: [] }) %>
