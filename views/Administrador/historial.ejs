<%- include('../partials/head', { title, styles }) %>
<div class="contenedor"><%- include('../partials/sidebar', { menu, usuario }) %><main class="contenido usuario-panel">
  <header class="usuario-encabezado"><div><p class="eyebrow">ADMINISTRACIÓN</p><h1>Mi historial</h1><span>Revisa únicamente los movimientos que has registrado.</span></div></header>
  <section class="usuario-tabla tabla admin-tabla"><div class="usuario-seccion-titulo"><div><p class="eyebrow">MOVIMIENTOS</p><h2>Mis registros</h2></div><span class="contador-registros"><%= actividad.length %> movimientos</span></div><div class="tabla-responsive"><table><thead><tr><th>Usuario</th><th>Acción</th><th>Módulo</th><th>Fecha y hora</th><th>Estado</th><th>Acciones</th></tr></thead><tbody><% if (actividad.length) { actividad.forEach(item => { %><tr><td><%= item.usuario %></td><td><%= item.accion %></td><td><%= item.modulo %></td><td><%= new Date(item.fecha).toLocaleString('es-MX') %></td><td><span class="<%= item.estatus %> estado-actividad"><%= item.estatus %></span></td><td class="acciones-registro"><form action="<%= item.tipo_registro === 'inventario' ? '/admin/inventario/' : '/admin/dictamen/' %><%= item.registro_id %>/eliminar" method="post" onsubmit="return confirm('¿Eliminar este registro?');"><button class="accion-icono eliminar" title="Eliminar" aria-label="Eliminar"><i class="fa-solid fa-trash"></i></button></form></td></tr><% }) } else { %><tr class="fila-vacia"><td colspan="6"><div class="estado-vacio estado-vacio-tabla"><span><i class="fa-solid fa-clock-rotate-left"></i></span><h3>No hay actividad registrada</h3><p>Tus movimientos aparecerán aquí cuando registres documentos.</p></div></td></tr><% } %></tbody></table></div></section>
</main></div><%- include('../partials/profile-modal', { usuario }) %><%- include('../partials/scripts', { sidebar: true, scripts: [] }) %>
