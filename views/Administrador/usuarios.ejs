<%- include('../partials/head', { title, styles }) %>
<div class="contenedor"><%- include('../partials/sidebar', { menu, usuario }) %><main class="contenido usuario-panel">
  <header class="usuario-encabezado"><div><p class="eyebrow">ADMINISTRACIÓN</p><h1>Usuarios del sistema</h1><span>Consulta los usuarios y su información de acceso.</span></div></header>
  <section class="usuario-tabla tabla admin-tabla"><div class="usuario-seccion-titulo"><div><p class="eyebrow">USUARIOS</p><h2>Usuarios registrados</h2></div><span class="contador-registros"><%= usuarios.length %> registros</span></div><div class="tabla-responsive"><table><thead><tr><th>Nombre</th><th>Correo</th><th>Rol</th><th>Puesto</th><th>Área</th></tr></thead><tbody><% if (usuarios.length) { usuarios.forEach(item => { %><tr><td><%= item.nombre %></td><td><%= item.correo %></td><td><span class="tipo-archivo"><%= item.rol %></span></td><td><%= item.puesto || 'Sin asignar' %></td><td><%= item.area || 'Sin asignar' %></td></tr><% }) } else { %><tr class="fila-vacia"><td colspan="5"><div class="estado-vacio estado-vacio-tabla"><span><i class="fa-solid fa-users"></i></span><h3>No hay usuarios registrados</h3><p>Los usuarios del sistema aparecerán en esta tabla.</p></div></td></tr><% } %></tbody></table></div></section>
</main></div><%- include('../partials/profile-modal', { usuario }) %><%- include('../partials/scripts', { sidebar: true, scripts: [] }) %>
