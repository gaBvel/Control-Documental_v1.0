<!-- Head -->
<%- include('../partials/head', { title, styles }) %>

<div class="contenedor">
    <!-- Sidebar -->
    <%- include('../partials/sidebar', { menu, usuario }) %>
    
    <main class="contenido">
        <header>
            <h1>Historial de inventarios</h1>
            <span>Consulta los inventarios aprobados, rechazados y pendientes.</span>
        </header>
        
        <section class="cards">
            <% [['folder','Inventarios registrados'],['circle-check','Aprobados'],['circle-xmark','Rechazados'],['clock','Pendientes']].forEach(card => { %>
                <div class="card">
                    <i class="fa-solid fa-<%= card[0] %>"></i>
                    <div>
                        <h2>0</h2>
                        <p><%= card[1] %></p>
                    </div>
                </div>
            <% }) %>
        </section>
        
        <section class="filtros">
            <input type="search" placeholder="Buscar por folio o usuario...">
            <select>
                <option>Todos</option>
                <option>Pendiente</option>
                <option>Aprobado</option>
                <option>Rechazado</option>
            </select>
            <button type="button">
                <i class="fa-solid fa-magnifying-glass"></i>
                Buscar
            </button>
        </section>
        
        <section class="tabla">
            <table>
                <thead>
                    <tr>
                        <th>Folio</th>
                        <th>Usuario</th>
                        <th>Tipo</th>
                        <th>Fecha de envío</th>
                        <th>Fecha revisión</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td colspan="6">No hay registros para mostrar.</td>
                    </tr>
                </tbody>
            </table>
        </section>
    </main>
</div>

<!-- Modal perfil -->
<%- include('../partials/profile-modal', { usuario }) %>

<!-- Scripts -->
<%- include('../partials/scripts', { sidebar: true, scripts: [] }) %>
