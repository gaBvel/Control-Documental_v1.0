<%- include('../partials/head', { title, styles }) %>
<div class="contenedor"><%- include('../partials/sidebar', { menu, usuario }) %><main class="contenido usuario-panel">
  <header class="usuario-encabezado"><div><p class="eyebrow">TRAZABILIDAD DOCUMENTAL</p><h1>Historial de Archivo</h1><span>Consulta los inventarios recibidos y las acciones realizadas.</span></div></header>
  <section class="usuario-tabla tabla"><div class="usuario-seccion-titulo"><div><p class="eyebrow">REGISTROS</p><h2>Historial de inventarios</h2></div><span class="contador-registros"><%= inventarios.length %> registros</span></div><div class="tabla-responsive"><table><thead><tr><th>Persona generadora</th><th>Fecha de envío</th><th>Fecha de resolución</th><th>Estatus</th><th>Archivo</th></tr></thead><tbody>
    <% if (inventarios.length) { inventarios.forEach(inventario => { %><tr><td><%= inventario.nombre %></td><td><%= new Date(inventario.fecha_envio).toLocaleString('es-MX') %></td><td><%= inventario.fecha_revision ? new Date(inventario.fecha_revision).toLocaleString('es-MX') : 'Pendiente' %></td><td><span class="<%= inventario.estatus %>"><%= inventario.estatus %></span></td><td><a href="<%= inventario.archivo_scv %>" target="_blank"><i class="fa-solid fa-file-csv"></i> Ver CSV</a></td></tr><% }) } else { %><tr class="fila-vacia"><td colspan="5"><div class="estado-vacio estado-vacio-tabla"><span><i class="fa-solid fa-clock-rotate-left"></i></span><h3>No hay registros para mostrar</h3><p>Los inventarios enviados aparecerán aquí para su consulta.</p></div></td></tr><% } %>
  </tbody></table></div></section>
</main></div><%- include('../partials/profile-modal', { usuario }) %><%- include('../partials/scripts', { sidebar: true, scripts: [] }) %>
