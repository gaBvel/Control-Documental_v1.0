<%- include('../partials/head', { title, styles }) %>
<div class="contenedor"><%- include('../partials/sidebar', { menu, usuario }) %><main class="contenido usuario-panel">
  <header class="usuario-encabezado"><div><p class="eyebrow">BANDEJA DE REVISIÓN</p><h1>Revisión de inventarios</h1><span>Valida los inventarios enviados por las áreas usuarias.</span></div><a class="boton-secundario" href="/archivo"><i class="fa-solid fa-arrow-left"></i> Volver al inicio</a></header>
  <section class="usuario-tabla tabla"><div class="usuario-seccion-titulo"><div><p class="eyebrow">PENDIENTES</p><h2>Inventarios por validar</h2></div><span class="contador-registros"><%= inventarios.length %> pendientes</span></div><div class="tabla-responsive"><table><thead><tr><th>Persona generadora</th><th>Subfondo</th><th>Unidad administrativa</th><th>Archivo</th><th>Acciones</th></tr></thead><tbody>
  <% if (inventarios.length) { inventarios.forEach(inventario => { %><tr><td><%= inventario.nombre %></td><td><%= inventario.subfondo %></td><td><%= inventario.unidad_administrativa %></td><td><a href="<%= inventario.archivo_scv %>" target="_blank"><i class="fa-solid fa-file-csv"></i> Ver CSV</a></td><td class="acciones-registro"><form action="/archivo/inventario/<%= inventario.id %>/estatus" method="post"><input type="hidden" name="estatus" value="aprobado"><button class="accion-icono aprobar" title="Aprobar" aria-label="Aprobar"><i class="fa-solid fa-check"></i></button></form><form action="/archivo/inventario/<%= inventario.id %>/estatus" method="post"><input type="hidden" name="estatus" value="rechazado"><button class="accion-icono rechazar" title="Rechazar" aria-label="Rechazar"><i class="fa-solid fa-xmark"></i></button></form></td></tr><% }) } else { %><tr class="fila-vacia"><td colspan="5"><div class="estado-vacio estado-vacio-tabla"><span><i class="fa-solid fa-clipboard-check"></i></span><h3>No hay inventarios pendientes</h3><p>Los inventarios que requieran validación aparecerán aquí.</p></div></td></tr><% } %>
  </tbody></table></div></section>
</main></div><%- include('../partials/profile-modal', { usuario }) %><%- include('../partials/scripts', { sidebar: true, scripts: [] }) %>
