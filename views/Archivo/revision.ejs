<!-- Head -->
<%- include('../partials/head', { title, styles }) %>

<div class="contenedor">
    <!-- Sidebar -->
    <%- include('../partials/sidebar', { menu, usuario }) %>
    
    <main class="contenido">
        <header>
            <h1>
                <i class="fa-solid fa-file-circle-check"></i>
                Revisión de inventarios
            </h1>
            <p>Inventarios enviados por los usuarios para su validación.</p>
        </header>
        
        <section class="tarjeta">
            <h2>Inventarios pendientes</h2>
            <table>
                <thead>
                    <tr>
                        <th>Usuario</th>
                        <th>Tipo de inventario</th>
                        <th>Fecha de envío</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td colspan="5">No hay inventarios pendientes de revisión.</td>
                    </tr>
                </tbody>
            </table>
        </section>
        
        <section class="observaciones">
            <h2>Observaciones</h2>
            <textarea placeholder="Escriba observaciones en caso de rechazo..."></textarea>
            <button type="button" class="guardar">Guardar observación</button>
        </section>
    </main>
</div>

<!-- Modal perfil -->
<%- include('../partials/profile-modal', { usuario }) %>

<!-- Scripts -->
<%- include('../partials/scripts', { sidebar: true, scripts: [] }) %>
