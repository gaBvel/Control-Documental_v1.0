<!-- Head -->
<%- include('../partials/head', { title, styles }) %>

<div class="contenedor">
    <!-- Sidebar -->
    <%- include('../partials/sidebar', { menu, usuario }) %>
    
    <main class="contenido">
        <header>
            <h1>Bienvenido, <%= usuario.nombre %></h1>
            <p>Panel de Archivo</p>
        </header>
        
        <section class="cards">
            <% [['folder-open','Inventarios pendientes'],['circle-check','Inventarios aprobados'],['circle-xmark','Inventarios rechazados'],['file-circle-check','Dictámenes pendientes']].forEach(card => { %>
                <div class="card">
                    <div class="icono">
                        <i class="fa-solid fa-<%= card[0] %>"></i>
                    </div>
                    <div>
                        <h2>0</h2>
                        <p><%= card[1] %></p>
                    </div>
                </div>
            <% }) %>
        </section>
        
        <section class="tabla">
            <div class="titulo">
                <h2>Inventarios pendientes de revisión</h2>
                <button type="button">
                    <i class="fa-solid fa-download"></i>
                    Exportar
                </button>
            </div>
            <table>
                <thead>
                    <tr>
                        <th>Folio</th>
                        <th>Usuario</th>
                        <th>Tipo</th>
                        <th>Fecha</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td colspan="5">No hay inventarios pendientes.</td>
                    </tr>
                </tbody>
            </table>
        </section>
    </main>
</div>

<!-- Modal perfil -->
<%- include('../partials/profile-modal', { usuario }) %>

<!-- Scripts -->
<%- include('../partials/scripts', { sidebar: true, scripts: [] }) %>
