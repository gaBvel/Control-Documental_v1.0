<%- include('../partials/head', { title, styles }) %>
<div class="contenedor"><%- include('../partials/sidebar', { menu, usuario }) %><main class="contenido usuario-panel">
  <header class="usuario-encabezado"><div><p class="eyebrow">PANEL DE ARCHIVO</p><h1>Bienvenido, <%= usuario.nombre %></h1><span>Administra y valida los inventarios documentales recibidos.</span></div><a class="boton-principal" href="/archivo/revision"><i class="fa-solid fa-clipboard-check"></i> Revisar inventarios</a></header>
  <section class="usuario-resumen"><article class="usuario-metrica"><span class="metrica-icono borrador"><i class="fa-solid fa-folder-open"></i></span><div><small>Pendientes</small><strong><%= resumen.pendiente %></strong><p>Requieren revisión</p></div></article><article class="usuario-metrica"><span class="metrica-icono aprobado"><i class="fa-solid fa-circle-check"></i></span><div><small>Aprobados</small><strong><%= resumen.aprobado %></strong><p>Inventarios validados</p></div></article><article class="usuario-metrica"><span class="metrica-icono rechazado"><i class="fa-solid fa-circle-xmark"></i></span><div><small>Rechazados</small><strong><%= resumen.rechazado %></strong><p>Con observaciones</p></div></article><article class="usuario-metrica"><span class="metrica-icono enviado"><i class="fa-solid fa-file-circle-check"></i></span><div><small>Dictámenes</small><strong><%= resumen.dictamenes %></strong><p>Registros disponibles</p></div></article></section>
  <section class="usuario-grid"><article class="usuario-tabla tabla"><div class="usuario-seccion-titulo"><div><p class="eyebrow">REVISIÓN PRIORITARIA</p><h2>Inventarios por revisar</h2><span>Envíos recibidos recientemente.</span></div><a href="/archivo/revision">Ir a revisión <i class="fa-solid fa-arrow-right"></i></a></div><div class="tabla-responsive"><table><thead><tr><th>Persona</th><th>Subfondo</th><th>Fecha</th></tr></thead><tbody><% if (recientes.length) { recientes.forEach(inventario => { %><tr><td><%= inventario.nombre %></td><td><%= inventario.subfondo %></td><td><%= new Date(inventario.fecha_envio).toLocaleDateString('es-MX') %></td></tr><% }) } else { %><tr class="fila-vacia"><td colspan="3"><div class="estado-vacio"><span><i class="fa-regular fa-folder-open"></i></span><h3>No hay inventarios pendientes</h3><p>Los nuevos inventarios aparecerán aquí.</p></div></td></tr><% } %></tbody></table></div></article><aside class="usuario-ayuda"><span class="ayuda-icono"><i class="fa-solid fa-list-check"></i></span><p class="eyebrow">CONTROL DE ARCHIVO</p><h2>Revisión organizada</h2><p>Valida los inventarios y registra observaciones para cada envío.</p><a href="/archivo/historial">Ver historial <i class="fa-solid fa-arrow-right"></i></a></aside></section>
</main></div><%- include('../partials/profile-modal', { usuario }) %><%- include('../partials/scripts', { sidebar: true, scripts: [] }) %>
