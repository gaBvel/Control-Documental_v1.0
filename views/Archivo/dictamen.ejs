<%- include('../partials/head', { title, styles }) %>
<div class="contenedor"><%- include('../partials/sidebar', { menu, usuario }) %><main class="contenido usuario-panel">
  <header class="usuario-encabezado"><div><p class="eyebrow">CONTROL DOCUMENTAL</p><h1>Dictámenes</h1><span>Consulta los dictámenes y sus documentos asociados.</span></div></header>
  <section class="usuario-tabla tabla"><div class="usuario-seccion-titulo"><div><p class="eyebrow">PENDIENTES</p><h2>Dictámenes por validar</h2></div><span class="contador-registros"><%= dictamenes.length %> pendientes</span></div><div class="tabla-responsive"><table><thead><tr><th>Responsable</th><th>Fecha</th><th>Tipo</th><th>Dictamen</th><th>Acta</th><th>Evidencia</th><th>Observaciones</th><th>Acciones</th></tr></thead><tbody>
  <% if (dictamenes.length) { dictamenes.forEach(dictamen => { %><tr><td><%= dictamen.responsable %></td><td><%= new Date(dictamen.fecha_dictamen).toLocaleDateString('es-MX') %></td><td><span class="pendiente"><%= dictamen.tipo_dictamen %></span></td><td><button class="boton-ver-archivo" type="button" data-file-view="<%= dictamen.archivo_dictamen %>" title="Ver dictamen" aria-label="Ver dictamen"><i class="fa-solid fa-eye"></i></button></td><td><% if (dictamen.archivo_acta) { %><button class="boton-ver-archivo" type="button" data-file-view="<%= dictamen.archivo_acta %>" title="Ver acta" aria-label="Ver acta"><i class="fa-solid fa-eye"></i></button><% } else { %>Sin archivo<% } %></td><td><% if (dictamen.evidencia) { %><button class="boton-ver-archivo" type="button" data-file-view="<%= dictamen.evidencia %>" title="Ver evidencia" aria-label="Ver evidencia"><i class="fa-solid fa-eye"></i></button><% } else { %>Sin evidencia<% } %></td><td><%= dictamen.observacion || 'Sin observaciones' %></td><td class="acciones-registro"><form action="/archivo/dictamen/<%= dictamen.id %>/estatus" method="post"><input type="hidden" name="estatus" value="aprobado"><button class="accion-icono aprobar" title="Aprobar" aria-label="Aprobar"><i class="fa-solid fa-check"></i></button></form><form action="/archivo/dictamen/<%= dictamen.id %>/estatus" method="post"><input type="hidden" name="estatus" value="rechazado"><button class="accion-icono rechazar" title="Rechazar" aria-label="Rechazar"><i class="fa-solid fa-xmark"></i></button></form></td></tr><% }) } else { %><tr class="fila-vacia"><td colspan="8"><div class="estado-vacio estado-vacio-tabla"><span><i class="fa-solid fa-file-signature"></i></span><h3>No hay dictámenes pendientes</h3><p>Los dictámenes enviados por Usuario y Administrador aparecerán aquí.</p></div></td></tr><% } %>
  </tbody></table></div></section>
</main></div><%- include('../partials/profile-modal', { usuario }) %><%- include('../partials/scripts', { sidebar: true, scripts: [] }) %>
