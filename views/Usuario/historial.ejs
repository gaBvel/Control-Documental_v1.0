
<%- include('../partials/head', { title, styles }) %>
<div class="contenedor">
    <!-- Sidebar -->
    <%- include('../partials/sidebar', { menu, usuario }) %>
    <main class="contenido">
        <header>
            <h1>Historial de <%= usuario.nombre %></h1>
            <p>Consulta el estado de tus inventarios.</p>
        </header>

        <section class="tabla">
            <table>
                <thead>
                    <tr>
                        <th>Tipo de inventario</th>
                        <th>Fecha de envío</th>
                        <th>Fecha A/R</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td colspan="4">No hay registros para mostrar.</td>
                    </tr>
                </tbody>
            </table>
        </section>
    </main>
</div>

<!-- Modal perfil usuario-->
<%- include('../partials/profile-modal', { usuario }) %>

<!-- Scripts -->
<%- include('../partials/scripts', { sidebar: true, scripts: [] }) %>
