<%- include('../partials/head', { title, styles }) %>
<div class="contenedor"><%- include('../partials/sidebar', { menu, usuario }) %><main class="contenido usuario-panel">
  <header class="usuario-encabezado"><div><p class="eyebrow">CONSULTA Y SEGUIMIENTO</p><h1>Historial de inventarios</h1><span>Revisa el estado y las fechas de todos tus envíos.</span></div><a class="boton-secundario" href="/usuario/inventario"><i class="fa-solid fa-plus"></i> Nuevo inventario</a></header>
  <section class="usuario-tabla tabla"><div class="usuario-seccion-titulo"><div><p class="eyebrow">MIS REGISTROS</p><h2>Historial completo</h2></div><span class="contador-registros"><%= inventarios.length %> registros</span></div><div class="tabla-responsive"><table><thead><tr><th>Subfondo</th><th>Unidad administrativa</th><th>Área generadora</th><th>Fecha de envío</th><th>Archivo CSV</th><th>Estatus</th></tr></thead><tbody>
    <% if (inventarios.length) { inventarios.forEach(inventario => { %><tr><td><%= inventario.subfondo %></td><td><%= inventario.unidad_administrativa %></td><td><%= inventario.area_generadora %></td><td><%= new Date(inventario.fecha_envio).toLocaleString('es-MX') %></td><td><button class="boton-ver-archivo" type="button" data-file-view="<%= inventario.archivo_scv %>" title="Ver inventario" aria-label="Ver inventario"><i class="fa-solid fa-eye"></i></button></td><td><span class="<%= inventario.estatus %>"><%= inventario.estatus %></span></td></tr><% }) } else { %><tr class="fila-vacia"><td colspan="6"><div class="estado-vacio estado-vacio-tabla"><span><i class="fa-solid fa-clock-rotate-left"></i></span><h3>No hay registros para mostrar</h3><p>Tus inventarios enviados y sus actualizaciones aparecerán aquí.</p></div></td></tr><% } %>
  </tbody></table></div></section>
</main></div><%- include('../partials/profile-modal', { usuario }) %><%- include('../partials/scripts', { sidebar: true, scripts: [] }) %>
